{
  "name": "site",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "km",
  "sourceRoot": "apps/site/src",
  "tags": [],
  "targets": {
    "build-angular": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/site",
        "browser": "apps/site/src/main.ts",
        "tsConfig": "apps/site/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/site/public"
          },
          {
            "glob": "noto-sans-{latin,latin-ext,cyrillic,greek,vietnamese}-wght-normal.woff2",
            "input": "node_modules/@fontsource-variable/noto-sans/files",
            "output": "fonts"
          },
          {
            "glob": "{us,ru}.svg",
            "input": "node_modules/flag-icons/flags/4x3",
            "output": "flags"
          }
        ],
        "styles": ["apps/site/src/styles.scss"],
        "server": "apps/site/src/main.server.ts",
        "outputMode": "static",
        "polyfills": [
          "core-js/stable/array/at",
          "core-js/stable/array/find-last",
          "core-js/stable/array/find-last-index",
          "core-js/stable/array/flat",
          "core-js/stable/array/flat-map",
          "core-js/stable/global-this",
          "core-js/stable/object/from-entries",
          "core-js/stable/object/has-own",
          "core-js/stable/promise/all-settled",
          "core-js/stable/promise/any",
          "core-js/stable/queue-microtask",
          "core-js/stable/string/at",
          "core-js/stable/string/match-all",
          "core-js/stable/string/replace-all",
          "@angular/localize/init"
        ],
        "localize": true,
        "i18nMissingTranslation": "error"
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            }
          ],
          "outputHashing": "all",
          "optimization": {
            "scripts": true,
            "styles": {
              "minify": true,
              "inlineCritical": false
            },
            "fonts": true
          }
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "localize": ["en"]
        }
      },
      "dependsOn": ["^content"]
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-angular"],
      "cache": true,
      "inputs": ["production", "^production", "{workspaceRoot}/tools/scripts/postbuild.mjs"],
      "outputs": ["{workspaceRoot}/dist/apps/site/browser/404.html"],
      "options": {
        "command": "node tools/scripts/postbuild.mjs"
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "site:build-angular:production"
        },
        "development": {
          "buildTarget": "site:build-angular:development"
        }
      },
      "dependsOn": ["^content"]
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "watch": false,
        "buildTarget": "site:build-angular:development"
      },
      "dependsOn": ["^content"]
    },
    "serve-static": {
      "continuous": true,
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "options": {
        "command": "http-server dist/apps/site/browser -p 4200 -c-1 --silent"
      }
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "site:build-angular",
        "format": "xlf",
        "outputPath": "apps/site/src/locale"
      },
      "dependsOn": ["^content"]
    },
    "lint": {
      "dependsOn": ["^content"]
    }
  },
  "i18n": {
    "sourceLocale": {
      "code": "en",
      "subPath": ""
    },
    "locales": {
      "ru": {
        "translation": "apps/site/src/locale/messages.ru.xlf",
        "subPath": "ru"
      },
      "es": {
        "translation": "apps/site/src/locale/messages.es.xlf",
        "subPath": "es"
      }
    }
  }
}
